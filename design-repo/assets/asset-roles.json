  "availabilityValues": {
    "reference-only": "Part of the Avec source. May appear only in a `reference` PageSpec (reproducing the source in an Avec-authorised context). A `generated` page must not contain it; generationSafeSubstitutes name what to use instead.",
    "generation-safe": "May appear in a `generated` PageSpec: token-only, placeholder, fictional or user-supplied. Carries no Avec asset, claim or identity.",
    "blocked-for-generation": "A third-party trademark or a real or demo person's likeness. Never reproduced in generated output, and in reference mode only inside an authorised context; substitutes name the safe alternative."
  },
  "modes": {
    "reference": "The PageSpec reproduces the Avec source (clone, QA, internal tooling). Source roles are allowed per field; generation-safe-only roles are rejected by the schema.",
    "generated": "A new page for any OTHER brand. No reference-only or blocked role, no Avec brand, store marks, URLs, reviews, ratings, people, media or marketing copy; only the roles each section lists in generatedAssetRoles."
  },
  "sourceBrand": {
    "names": [
      "Avec",
      "avec.ai",
      "Nearly Extraterrestrial Technology, Inc."
    ],
    "note": "Matched case-insensitively against EVERY string in a `generated` PageSpec (headings, body, labels, alt text, hrefs, route, meta). Every regex is traced to a real string in the source (`examples`); verify_all.py checks that each example exists in the source when it is present and that each regex matches an example. No human has reviewed these patterns.",
    "patterns": {
      "brand": {
        "rule": "GENERATED_MODE_SOURCE_BRAND",
        "regex": [
          "\\bavec(mail)?\\b",
          "avec[-_ ]?(logo|glyph)",
          "nearly\\s+extraterrestrial"
        ],
        "examples": [
          {
            "text": "Avec is available for",
            "path": "src/content.js"
          },
          {
            "text": "avecmail",
            "path": "src/content.js"
          },
          {
            "text": "avec-logo",
            "path": "CLONE_SPEC.md"
          },
          {
            "text": "Nearly Extraterrestrial Technology",
            "path": "src/components/Footer.jsx"
          }
        ],
        "evidenceIds": [
          "ev.src.content-footer",
          "ev.gen.copyright"
        ]
      },
      "storeMarks": {
        "rule": "GENERATED_MODE_STORE_MARK",
        "regex": [
          "test\\s*flight",
          "app\\s*store",
          "\\boutlook\\b",
          "\\bandroid\\b"
        ],
        "examples": [
          {
            "text": "testflight.png",
            "path": "CLONE_SPEC.md"
          },
          {
            "text": "App Store wordmark",
            "path": "CLONE_SPEC.md"
          },
