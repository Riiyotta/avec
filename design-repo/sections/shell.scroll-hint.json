    "required": true,
    "position": "shell",
    "fixed": true
  },
  "contentSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "leadText",
      "trailText",
      "hiddenOnStops",
      "idleDelayMs"
    ],
    "properties": {
      "leadText": {
        "type": "string",
        "minLength": 1
      },
      "trailText": {
        "type": "string",
        "minLength": 1
      },
      "hiddenOnStops": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "hero",
            "deck_intro",
            "deck_swipe_done",
            "deck_swipe_later",
            "triage_game",
            "compose_intro",
            "compose_record",
            "compose_drafted",
            "low_importance",
            "deck_empty",
            "search",
            "notifications",
            "footer"
          ]
        }
      },
      "idleDelayMs": {
        "const": 5000
      }
    }
  },
  "fieldBudgets": {
    "leadText": {
      "maxWords": 4,
      "realMaxWordCount": 3
    },
    "trailText": {
      "maxWords": 7,
      "realMaxWordCount": 5
    }
  },
  "motion": {
    "pattern": "idle-fade-float",
    "trigger": "time",
    "reducedMotionFallback": "instant-state-change",
    "durationTokens": [
      "stage",
      "fast"
    ],
    "notes": "fade in 500ms after 5s idle, out 150ms on scroll; animate-float 2s infinite"
