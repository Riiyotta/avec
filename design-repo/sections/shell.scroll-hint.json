{
  "id": "shell.scroll-hint",
  "layer": "section",
  "category": "SHELL",
  "purpose": "Teaches the non-standard paging interaction after the visitor idles.",
  "sourceComponent": "src/components/ScrollHint.jsx",
  "scrollStops": [
    "hero",
    "deck_intro",
    "deck_swipe_done",
    "deck_swipe_later",
    "triage_game",
    "compose_intro",
    "compose_record",
    "compose_drafted",
    "low_importance",
    "deck_empty",
    "search",
    "notifications",
    "footer"
  ],
  "variants": [
    "default"
  ],
  "constraints": {
