{
  "id": "expand.search-demo",
  "layer": "section",
  "category": "EXPAND",
  "purpose": "Prove 'find anything' with a typed natural-language query and a sourced answer.",
  "sourceComponent": "src/components/Expand.jsx",
  "scrollStops": [
    "search"
  ],
  "variants": [
    "default"
  ],
  "constraints": {
    "onePerPage": true,
    "required": true,
    "group": "expand"
  },
  "contentSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "headline",
      "query",
      "answer",
      "sources"
    ],
    "properties": {
      "headline": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "answer": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "name",
            "subject",
            "preview",
            "avatar"
          ],
          "properties": {
            "initial": {
              "type": "string",
              "pattern": "^[A-Z]{1,2}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "preview": {
              "type": "string",
              "minLength": 1
            },
            "avatar": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetRole",
                "colorToken"
              ],
              "properties": {
                "assetRole": {
                  "const": "avatar.initials"
                },
                "colorToken": {
                  "enum": [
                    "accent-green",
                    "accent-sky"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "fieldBudgets": {
    "headline": {
      "maxWords": 14,
      "realMaxWordCount": 11
    },
    "query": {
      "maxWords": 8,
      "realMaxWordCount": 6
    },
    "answer": {
      "maxWords": 24,
      "realMaxWordCount": 19
    },
    "sources[].name": {
      "maxWords": 4,
      "realMaxWordCount": 3
    },
    "sources[].subject": {
      "maxWords": 8,
      "realMaxWordCount": 6
    },
    "sources[].preview": {
      "maxWords": 25,
      "realMaxWordCount": 20
    }
  },
  "motion": {
    "pattern": "typing-query-state",
    "trigger": "scroll-state",
    "reducedMotionFallback": "instant-state-change",
    "durationTokens": [
      "type-char",
      "headline",
      "card"
    ],
    "notes": "at B5: headline in (.4s, +.1s); query typed 35ms/char after 400ms; answer cards translate-y-4 -> 0, 300ms +200ms"
  },
  "responsive": [
    {
      "query": "max-md",
      "changes": [
        "pill icon size-4, cards p-4, gap-3"
      ]
    },
    {
      "query": "tall-height",
      "changes": [
        "--search-anchor 30%, --headline-offset 180px"
      ]
    }
  ],
  "accessibility": [
    "headline is real text with decorative blurred halo span"
  ],
  "assetRoles": [
    "avatar.initials"
  ],
  "referenceContent": {
