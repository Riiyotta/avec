            "subject": "A spot opened up in Saturday's class",
            "sender": "PilatesPass",
            "time": "2 days ago",
            "to": "You",
            "body": "A spot just opened up in Saturday's 9am Pilates with Maya — a class you've been waitlisted for.\n\nConfirm your booking now, before it's offered to the next member.",
            "avatar": {
              "assetRole": "avatar.sender-photo",
              "assetRef": "/assets/avatars/pilates-pass.png"
            }
          },
