            "subject": "Your flight to Austin is ready for check-in",
            "sender": "Pacific Air Lines",
            "time": "2 days ago",
            "to": "You",
            "body": "Check-in is now open for Flight PA 284 to Austin–Bergstrom, departing tomorrow at 7:45am from Terminal B, Gate 22.\n\nDownload your boarding pass for faster airport screening.\n\nHave a great flight!",
            "avatar": {
              "assetRole": "avatar.sender-photo",
              "assetRef": "/assets/avatars/pacific-airlines.png"
            }
          },
